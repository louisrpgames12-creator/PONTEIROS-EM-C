#include <stdio.h>
void imprimir(int v[], int tamanho, int *maior, int *menor) {
    printf("MAIOR: %d\n", *maior);
    printf("MENOR: %d", *menor);
}

int main() {
    int vetor[4] = {10, 20, 30, 40}, tamanho = 4, menor = 1000, maior = 0, i;

    for(i = 0; i < 4; i++) {
        if(menor > vetor[i])
        menor = vetor[i];
        if(maior < vetor[i])
        maior = vetor[i];
    }

    imprimir(vetor, tamanho, &maior, &menor);

    return 0;
}
