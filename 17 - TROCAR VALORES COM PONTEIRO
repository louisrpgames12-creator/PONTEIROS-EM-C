#include <stdio.h>
void trocar_valores(int *inteiro1, int *inteiro2) {
        int aux;
        aux = *inteiro2;
        *inteiro2 = *inteiro1;
        *inteiro1 = aux;

}

int main() {
    int inteiro1, inteiro2;

    printf("ME INFORME O VALOR 1 E O VALOR 2: ");
    scanf("%d%d", &inteiro1, &inteiro2);

    trocar_valores(&inteiro1, &inteiro2);

    printf("%d %d", inteiro1, inteiro2);
    

    return 0;
}
