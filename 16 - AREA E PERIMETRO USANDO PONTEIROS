#include <stdio.h>
void calcular_retangulo(int base, int altura, int *perimetro, int *area) {
    *area = base * altura;
    *perimetro = (2 * altura) + (2 * base);

}

int main() {
    int base, altura, perimetro, area;

    printf("ME INFORME A BASE E A ALTURA: ");
    scanf("%d%d", &base, &altura);

    calcular_retangulo(base, altura, &perimetro, &area);

    printf("AREA = %d\nPERIMETRO = %d", area, perimetro);
    

    return 0;
}
